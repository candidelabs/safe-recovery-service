{
  "options": {
    "env": "development",
    "port": "4337",
    "indexerAlert": "alert-1",
    "skipFirstAccountSetupAlert": false,
    "suppressAlerts": false,
    "trustProxy": true,
    "sentryDSN": "...",
    "rateLimit": 50,
    "supportEmail": "support@example.com"
  },

  "signers": [
    {
      "id": "signer-1",
      "privateKey": "${ENV::ENVIRONMENT_VARIABLE_NAME_FOR_PRIVATE_KEY}"
    },
    {
      "id": "signer-2",
      "awsKMS": {
        "accessKeyId": "${ENV::ENVIRONMENT_VARIABLE_NAME_FOR_ACCESS_KEY_ID}",
        "secretAccessKeyId": "...",
        "region": "eu-north-1",
        "kmsKeyId": "...."
      }
    },
    {
      "id": "signer-3",
      "privateKey": "0x..."
    }
  ],

  "alerts": [
    {
      "id": "alert-1",
      "channels": {
        "email": {
          "smtp": {
            "from": "Test Labs <alert@testlabs.com>",
            "host": "smtp.server.io",
            "port": 465,
            "secure": true,
            "auth": {
              "type": "login",
              "user": "....",
              "pass": "...."
            }
          }
        },
        "sms": {
          "twilio": {
            "accountSid": "....",
            "authToken": "....",
            "fromNumber": "..."
          }
        }
      }
    },
    {
      "id": "alert-2",
      "channels": {
        "email": {
          "webhook": {
            "endpoint": "https://webhook.endpoint/",
            "authorizationHeader": "Bearer BEARER_TOKEN"
          }
        },
        "sms": {
          "webhook": {
            "endpoint": "https://webhook.endpoint/"
          }
        }
      }
    }
  ],

  "networks": {
    "sepolia": {
      "enabled": true,
      "chainId": 11155111,
      "jsonRpcEndpoint": "https://ethereum-sepolia-rpc.publicnode.com",
      "recoveryModules": [
        {"address": "0x949d01d424bE050D09C16025dd007CB59b3A8c66", "fallback": true, "indexer": {"enabled": true, "startBlock": 4337}},
        {"address": "0x38275826E1933303E508433dD5f289315Da2541c", "indexer": {"enabled": true, "startBlock": "<deployment block>"}},
        {"address": "0x088f6cfD8BB1dDb1BB069CCb3fc1A98927D233f2", "indexer": {"enabled": true, "startBlock": "<deployment block>"}},
        {"address": "0x9BacD92F4687Db306D7ded5d4513a51EA05df25b", "indexer": {"enabled": true, "startBlock": "<deployment block>"}},
        {"address": "0x4dF6081A82E07A7cD99aEf91C72d12a5138e468B", "indexer": {"enabled": true, "startBlock": "<deployment block>"}},
        {"address": "0x00480F5ecC008995469fA7e12c70Ef3DC9FEe7fD", "indexer": {"enabled": true, "startBlock": "<deployment block>"}},
        {"address": "0xEaC444E2F28469E641215F129874Aff8294cAfE0", "indexer": {"enabled": true, "startBlock": "<deployment block>"}},
        {"address": "0x4d92D03a47468d9FC62495d85E3F205b4616FC5c", "indexer": {"enabled": true, "startBlock": "<deployment block>"}}
      ],
      "executeRecoveryRequests": {
        "enabled": false,
        "rateLimit": "~"
      },
      "finalizeRecoveryRequests": {
        "enabled": true,
        "signer": "signer-1",
        "rateLimit": {
          "maxPerAccount": 5,
          "period": "30d"
        }
      },
      "guardian": "signer-1",
      "alerts": "alert-2"
    }
  }
}